{
  "name": "quickspaces",
  "type": "module",
  "displayName": "Quickspaces",
  "publisher": "UtopikCode",
  "description": "",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.110.0"
  },
  "activationEvents": [
    "onUri"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickspaces",
          "title": "Quickspaces",
          "icon": "resources/quickspaces.svg"
        }
      ]
    },
    "views": {
      "quickspaces": [
        {
          "id": "quickspacesView",
          "name": ""
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quickspacesView",
        "contents": "No control plane configured.\n[Add Control Plane](command:quickspaces.addControlPlane)\n\nAdd a remote control plane URL to get started.",
        "when": "!quickspaces.hasControlPlane && !quickspaces.isInitializing"
      }
    ],
    "commands": [
      {
        "command": "quickspaces.addControlPlane",
        "title": "Add Control Plane",
        "icon": "$(add)"
      },
      {
        "command": "quickspaces.addWorkspace",
        "title": "Login and list repositories",
        "icon": "$(add)"
      },
      {
        "command": "quickspaces.configureControlPlane",
        "title": "Configure Control Plane",
        "icon": "$(settings-gear)"
      },
      {
        "command": "quickspaces.connectWorkspace",
        "title": "Connect Workspace",
        "icon": "$(link)"
      },
      {
        "command": "quickspaces.deleteWorkspace",
        "title": "Delete Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "quickspaces.configureWorkspace",
        "title": "Configure Workspace",
        "icon": "$(settings-gear)"
      },
      {
        "command": "quickspaces.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quickspaces.addControlPlane",
          "when": "view == quickspacesView",
          "group": "navigation@1"
        },
        {
          "command": "quickspaces.refresh",
          "when": "view == quickspacesView",
          "group": "navigation@2"
        }
      ],
      "view/item/inline": [
        {
          "command": "quickspaces.addWorkspace",
          "when": "view == quickspacesView && viewItem == controlPlane",
          "group": "inline@3"
        },
        {
          "command": "quickspaces.refresh",
          "when": "view == quickspacesView && viewItem == controlPlane",
          "group": "inline@1"
        },
        {
          "command": "quickspaces.configureControlPlane",
          "when": "view == quickspacesView && viewItem == controlPlane",
          "group": "inline@2"
        },
        {
          "command": "quickspaces.connectWorkspace",
          "when": "view == quickspacesView && viewItem == workspace",
          "group": "inline@1"
        }
      ],
      "view/item/context": [
        {
          "command": "quickspaces.addWorkspace",
          "when": "view == quickspacesView && viewItem == controlPlane",
          "group": "inline@1"
        },
        {
          "command": "quickspaces.refresh",
          "when": "view == quickspacesView && viewItem == controlPlane",
          "group": "inline@2"
        },
        {
          "command": "quickspaces.configureControlPlane",
          "when": "view == quickspacesView && viewItem == controlPlane",
          "group": "inline@3"
        },
        {
          "command": "quickspaces.connectWorkspace",
          "when": "view == quickspacesView && viewItem == workspace",
          "group": "navigation@4"
        },
        {
          "command": "quickspaces.deleteWorkspace",
          "when": "view == quickspacesView && viewItem == workspace",
          "group": "navigation@5"
        }
      ]
    }
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "^1.0.0-preview.100",
    "@microsoft/kiota-serialization-form": "^1.0.0-preview.100",
    "@microsoft/kiota-serialization-json": "^1.0.0-preview.100",
    "@microsoft/kiota-serialization-multipart": "^1.0.0-preview.100",
    "@microsoft/kiota-serialization-text": "^1.0.0-preview.100",
    "@utopikcode/quickspaces-control-plane-api-client": "^0.0.0-alpha.12"
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.cjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:headless": "xvfb-run -a yarn run test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
